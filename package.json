{
  "name": "scb-mcp",
  "version": "0.1.0",
  "description": "An MCP server over Statistics Sweden's business register: search, count and read workplaces from an assistant.",
  "type": "module",
  "bin": { "scb-mcp": "./dist/bin.js" },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": { "node": ">=22.6" },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
